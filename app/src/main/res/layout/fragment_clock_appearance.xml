<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/primaryShadeDarkColor"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/settings_side_padding">

    <TextView
        style="@style/TextLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:text="@string/clock_appearance" />

    <LinearLayout
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="190dp"
        android:orientation="vertical"
        android:paddingHorizontal="24dp">

        <app.olauncher.ui.FittingTextClock
            android:id="@+id/previewClock"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="@dimen/home_app_padding_vertical"
            android:textSize="@dimen/time_size" />

        <TextView
            android:id="@+id/previewDate"
            style="@style/TextDefault"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/home_app_padding_vertical"
            android:textSize="@dimen/text_large" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fadingEdgeLength="48dp"
        android:overScrollMode="never"
        android:requiresFadingEdge="vertical"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="32dp">

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/clock" />

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/font" />

                    <TextView
                        android:id="@+id/clockFont"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/weight" />

                    <TextView
                        android:id="@+id/clockWeight"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/time_format" />

                    <TextView
                        android:id="@+id/timeFormat"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/clockSizeValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/clockSize" />

                    <SeekBar
                        android:id="@+id/clockSize"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/clockSpacingValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/clockSpacing" />

                    <SeekBar
                        android:id="@+id/clockSpacing"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/clockMarginValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/clockMargin" />

                    <SeekBar
                        android:id="@+id/clockMargin"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                style="@style/SettingsHeader"
                android:text="@string/date" />

            <LinearLayout style="@style/SettingsCard">

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/font" />

                    <TextView
                        android:id="@+id/dateFont"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/weight" />

                    <TextView
                        android:id="@+id/dateWeight"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        style="@style/SettingsTitle"
                        android:text="@string/date_format" />

                    <TextView
                        android:id="@+id/dateFormat"
                        style="@style/SettingsSummary" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/dateSizeValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/dateSize" />

                    <SeekBar
                        android:id="@+id/dateSize"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/dateSpacingValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/dateSpacing" />

                    <SeekBar
                        android:id="@+id/dateSpacing"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/dateMarginValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/dateMargin" />

                    <SeekBar
                        android:id="@+id/dateMargin"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

                <LinearLayout style="@style/SettingsRow">

                    <TextView
                        android:id="@+id/lineGapValue"
                        style="@style/SettingsTitle"
                        android:labelFor="@id/lineGap" />

                    <SeekBar
                        android:id="@+id/lineGap"
                        android:layout_width="match_parent"
                        android:layout_height="40dp" />
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                style="@style/SettingsCard"
                android:layout_marginTop="24dp">

                <TextView
                    android:id="@+id/reset"
                    style="@style/SettingsAction"
                    android:text="@string/reset" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
